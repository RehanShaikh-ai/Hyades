# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=knowledge_atlas
DATABASE_USER=knowledge_atlas
DATABASE_PASSWORD=change_me

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Vector Store (Qdrant) — Contract v0.3.1 §15 ──────────────────────────────
# Qdrant service base URL. In Docker Compose, use the service name as host.
QDRANT_URL=http://qdrant:6333
# Prefix for Qdrant collection names. Collection formula: {prefix}_{workspace_id}
# See vector_service.collection_name() — never construct collection names inline.
QDRANT_COLLECTION_PREFIX=ka

# ── Job Queue (Redis / ARQ) — Contract v0.3.1 §15 ────────────────────────────
# Redis is used as the ARQ transport only — no persistent application data.
REDIS_URL=redis://redis:6379/0

# ── Git Versioning — Contract v0.3.1 §15, §16.2 ─────────────────────────────
# Host-side path for Git repositories (mapped to the git_repositories volume).
# Must match the volume mount target inside backend/worker containers.
GIT_REPOSITORY_ROOT=/data/workspaces

# ── Embedding Provider — Contract v0.3.1 §15 ─────────────────────────────────
# Provider: fastembed (default, local, no external API) or ollama
EMBEDDING_PROVIDER=fastembed
# Model identifier — must be consistent within a collection.
# Changing this requires a full workspace reindex (§7.4).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the actual output dimension of EMBEDDING_MODEL.
# Mismatches raise EMBEDDING_DIMENSION_MISMATCH (§7.4).
EMBEDDING_DIMENSION=384

# ── Chunking — Contract v0.3.1 §15, §8 ───────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# markdown_heading (default) or fixed_size
CHUNKING_STRATEGY=markdown_heading

# ── LLM Provider — Contract v0.3.1 §15 ───────────────────────────────────────
# Provider: freellmapi (default with auto-discovery), ollama, or omniroute
LLM_PROVIDER=freellmapi
LLM_MODEL=auto

# FreeLLMAPI (Unified free AI router: auto-fails over between providers)
FREELLMAPI_BASE_URL=http://host.docker.internal:3001
# FREELLMAPI_API_KEY=   ← Discovered automatically from ~/freellmapi or set manually here

# Ollama (alternative local LLM / embedding server)
OLLAMA_BASE_URL=http://ollama:11434

# OmniRoute (optional external LLM router)
# OMNIROUTE_BASE_URL=https://...

# ── Background Jobs — Contract v0.3.1 §15 ────────────────────────────────────
# Maximum ARQ job retry attempts before terminal failure.
JOB_MAX_RETRIES=3
# Hard timeout (seconds) for LLM and Git operations (§11.3, §11.1).
PROVIDER_TIMEOUT_SECONDS=30
# Maximum tokens assembled for RAG context window (§10).
CONTEXT_TOKEN_LIMIT=4096

# ── v0.4.1 — Sources & Persistent Assistant — Contract v0.4.1 §15 ──────────────
# Max messages from conversation history injected into LLM prompt (§15).
CONVERSATION_HISTORY_LIMIT=10
# Maximum individual file upload size in megabytes (§15).
SOURCE_MAX_FILE_SIZE_MB=25
# Hard timeout (seconds) for source processing background jobs (§15).
SOURCE_PROCESSING_TIMEOUT_SECONDS=120
